.page {
  display: flex;
  flex-direction: column;
  background: #f3f3f1;
  color: #1c1c1c;
  overflow: hidden;
}

.head { flex: none; }

.title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 12px 16px 8px;
}

.name {
  font-size: 22px;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.step { color: #3f3f3f; font-size: 14px; }

.disclaimer {
  background: #fff6e4;
  color: #3d2910;
  border-top: 1px solid #e4c48a;
  border-bottom: 1px solid #e4c48a;
  padding: 10px 16px 12px;
}

.lead, .rest { display: block; }

.lead { font-weight: 600; font-size: 15px; }

.rest {
  margin-top: 6px;
  font-size: 13px;
  line-height: 1.45;
}

.compare {
  flex: 1;
  min-height: 0;
  padding: 10px 16px 8px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.btn::after { border: none; }

.btn {
  margin: 0;
  min-height: 40px;
  line-height: 40px;
  padding: 0 12px;
  font-size: 14px;
  background: #fff;
  color: #1c1c1c;
  border: 1px solid #1c1c1c;
  border-radius: 0;
}

.btn.primary {
  background: #1c1c1c;
  color: #fff;
}

.btn[disabled] { opacity: 0.38; }

.meta, .status, .fine, .prose, .strong, .h2 {
  display: block;
}

.meta, .status { margin-top: 8px; font-size: 13px; color: #3f3f3f; }

.toggle {
  display: flex;
  margin-top: 8px;
  border: 1px solid #1c1c1c;
  align-self: flex-start;
}

.segment {
  min-width: 88px;
  min-height: 36px;
  line-height: 36px;
  text-align: center;
  font-size: 14px;
}

.segment.on { background: #1c1c1c; color: #fff; }

.pics {
  margin-top: 8px;
  display: flex;
  gap: 8px;
  min-height: 0;
}

.pane {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.cap { font-size: 13px; font-weight: 600; margin-bottom: 4px; }

.pic { flex: 1; width: 100%; background: #e4e4df; }

.empty {
  margin-top: 12px;
  min-height: 120px;
  background: #e4e4df;
  color: #3f3f3f;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 16px;
}

.wipe { margin-top: 8px; display: flex; flex-direction: column; min-height: 0; }

.wipe-labels {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 4px;
}

.wipe-frame {
  position: relative;
  flex: 1;
  min-height: 0;
  background: #e4e4df;
}

.wipe-img { width: 100%; height: 100%; }

.wipe-clip {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
}

.wipe-under {
  position: absolute;
  left: 0;
  top: 0;
}

.wipe-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2px;
  margin-left: -1px;
  background: #1c1c1c;
}

.split { margin-top: 4px; }

.sheet {
  flex: none;
  border-top: 1px solid #cfcfc8;
  background: #f3f3f1;
}

.sheet-inner { padding: 12px 16px 24px; }

.h2 { margin-top: 8px; font-size: 16px; font-weight: 600; }

.recipes {
  display: flex;
  margin-top: 8px;
  border: 1px solid #1c1c1c;
}

.recipe {
  flex: 1;
  min-height: 44px;
  line-height: 44px;
  text-align: center;
}

.recipe.on { background: #1c1c1c; color: #fff; }

.strong { margin-top: 10px; font-weight: 600; }

.prose { margin-top: 4px; }

.fine { margin-top: 6px; color: #3f3f3f; font-size: 13px; line-height: 1.45; }

.intensity-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16px;
}

.intensity-num { font-size: 20px; font-weight: 600; }

.ends {
  display: flex;
  justify-content: space-between;
  color: #3f3f3f;
  font-size: 12px;
}

.params-title { margin-top: 18px; }

.ruler {
  display: flex;
  justify-content: space-between;
  margin-top: 10px;
  color: #3f3f3f;
  font-size: 12px;
}

.param { padding: 10px 0; border-top: 1px solid #cfcfc8; }

.param-top {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.param-name { flex: 1; font-weight: 600; }

.en { display: block; font-size: 12px; font-weight: 400; color: #3f3f3f; }

.param-value { text-align: right; }

.base { display: block; font-size: 12px; color: #3f3f3f; }

.state { min-width: 3.2em; text-align: right; font-size: 13px; color: #3f3f3f; }

.state.regional, .state.negative-unverified { color: #6b3e00; font-weight: 600; }

.meter { position: relative; height: 16px; margin-top: 6px; }

.track, .fill {
  position: absolute;
  top: 7px;
  height: 2px;
}

.track { left: 0; right: 0; background: #c8c8c0; }

.zero {
  position: absolute;
  left: 50%;
  top: 2px;
  width: 1px;
  height: 12px;
  background: #1c1c1c;
}

.fill { background: #1c1c1c; }

.fill.regional, .fill.negative-unverified { background: #6b3e00; }

.why { display: block; margin-top: 4px; color: #3f3f3f; font-size: 12px; }

.foot { margin-top: 16px; }

.work {
  position: fixed;
  left: -4000px;
  top: 0;
  width: 10px;
  height: 10px;
}
